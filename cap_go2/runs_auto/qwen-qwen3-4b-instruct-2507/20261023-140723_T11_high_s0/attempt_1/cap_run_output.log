# 赤い箱までの距離を計算し、その手前まで移動する
# 障害物（壁）があるため、直接移動するとぶつかる可能性があるため、
# 壁の位置を確認して安全な経路を取る

# 赤い箱の位置を取得
red_box_x, red_box_y = get_object_position("red_box")
# 壁の位置を取得
wall_x, wall_y = get_object_position("wall")

# ロボットの現在位置を取得
robot_x, robot_y = get_position()
robot_yaw = get_yaw()

# ロボットが壁の前を通過できるか確認（壁の中心は (2.0, 0.0)、幅は 0.3×1.6）
# 壁の左端と右端のx座標は 2.0 ± 0.15（幅0.3なので）
wall_left = wall_x - wall_size_x / 2
wall_right = wall_x + wall_size_x / 2

# まず、壁に向かって右にずらして、壁の前に進むようにする
# 赤い箱は (4.0, 0.0) なので、x軸方向に進むのが最短経路
# しかし、壁があるため、x=2.0付近で左右にずらす必要がある

# まず、ロボットをx軸方向に進むようにする（0度で前が+X）
# 壁の中心 (2.0, 0.0) に近づく前に、壁の前を通過できるようにする
# つまり、x=2.0 まで進んで、その後右にずらして進む

# 1. 壁の手前（x=2.0）まで進む
move_forward(2.0)

# 2. 今の位置で、壁の前を通過できるように、右に少しずらす（y方向に0.1ずらす）
move_sideways(0.1)

# 3. その後、赤い箱（4.0, 0.0）に向かって進む
move_to(4.0, 0.0, tolerance=0.3)

# 到着まで完了
stop(1.0)

